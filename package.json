{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build.cjs",
    "clean": "hexo clean",
    "deploy": "node tools/write.cjs push",
    "server": "hexo server",
    "dev": "hexo server --draft",
    "new": "node tools/write.cjs new",
    "publish": "node tools/write.cjs publish",
    "ship": "node tools/write.cjs push",
    "check": "node tools/check-site.cjs",
    "verify": "npm run build && npm run check",
    "test": "node --test tools/writing.test.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-front-matter": "4.2.1",
    "hexo-util": "3.3.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.4.3",
    "hexo-theme-landscape": "^1.0.0"
  }
}
