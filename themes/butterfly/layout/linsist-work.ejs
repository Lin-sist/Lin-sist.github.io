<% const project = page.project; const projects = page.projects; const heading = project ? project.name : '作品'; const canonical = config.url + url_for(project ? project.path : 'work/'); -%>
<!doctype html>
<html lang="zh-CN" data-theme="dark" data-search-index="<%= url_for('linsist/search.json') %>" data-site-root="<%= url_for('/') %>">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark light"><meta name="theme-color" content="#0b1420">
  <title><%= heading %> · Linsist</title><meta name="description" content="<%= project ? project.description : 'Linsist 的项目实践：知识库问答 RAG 与时光回序 Flashback。' %>"><link rel="canonical" href="<%= canonical %>">
  <meta property="og:type" content="website"><meta property="og:title" content="<%= heading %> · Linsist"><meta property="og:description" content="<%= project ? project.description : '从知识问答到个人记录，把想法做到具体。' %>"><meta property="og:url" content="<%= canonical %>">
  <meta property="og:image" content="<%= config.url + url_for('linsist/assets/' + (project ? project.image : projects[0].image)) %>">
  <link rel="icon" href="<%= url_for('linsist/assets/favicon.svg') %>" type="image/svg+xml"><link rel="stylesheet" href="<%= url_for('linsist/style.css') %>"><link rel="stylesheet" href="<%= url_for('linsist/reading.css') %>"><link rel="stylesheet" href="<%= url_for('linsist/work.css') %>">
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('lin-theme')==='light'?'light':'dark'}catch{}</script>
  <link rel="stylesheet" href="<%= url_for('linsist/motion.css') %>">
  <script src="<%= url_for('linsist/motion.js') %>"></script>
  <script src="<%= url_for('linsist/reading.js') %>" defer></script><script src="<%= url_for('linsist/work.js') %>" defer></script>
</head>
<body class="reading-page work-page">
  <a class="skip-link" href="#main">跳转到正文</a>
  <header class="site-header is-scrolled reading-header"><a class="wordmark" href="<%= url_for('/') %>" aria-label="Linsist，返回首页">Linsist<span class="brand-dot" aria-hidden="true">.</span></a><nav class="desktop-nav" aria-label="主导航"><a href="<%= url_for('/') %>">首页</a><a href="<%= url_for('work/') %>" aria-current="page">作品</a><a href="<%= url_for('/#writing') %>">文章</a><a href="<%= url_for('/#about') %>">关于</a></nav><div class="header-actions"><button class="icon-button search-trigger" type="button" aria-label="搜索文章"><span class="search-icon" aria-hidden="true"></span><kbd>/</kbd></button><button class="icon-button theme-toggle" type="button" aria-label="切换为浅色主题"><span aria-hidden="true">◐</span></button><a class="github-link" href="https://github.com/Lin-sist" target="_blank" rel="noopener noreferrer">GitHub ↗</a><button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开导航菜单"><span class="menu-icon" aria-hidden="true"></span></button></div><nav id="mobile-nav" aria-label="手机导航" hidden><a href="<%= url_for('/') %>">首页</a><a href="<%= url_for('work/') %>">作品</a><a href="<%= url_for('/#writing') %>">文章</a><a href="<%= url_for('/#about') %>">关于</a></nav></header>
  <main id="main" class="work-shell">
    <% if (!project) { -%>
    <header class="work-intro"><div><p class="section-label">作品与实践 / Selected work</p><h1>把想法，<br class="work-title-break">做到具体<span>。</span></h1></div><p>一边追问答案的依据，<br>一边为生活的片段留出位置。<span>两个项目，两种把想法落到界面的尝试。</span></p></header>
    <div class="work-toolbar"><div class="work-filters" hidden aria-label="按方向筛选作品"><button type="button" data-work-filter="all" aria-pressed="true">全部</button><button type="button" data-work-filter="ai" aria-pressed="false">AI 应用</button><button type="button" data-work-filter="product" aria-pressed="false">产品实践</button></div><span id="work-count" role="status">2 个项目</span></div>
    <div class="work-list">
      <% projects.forEach(function(item) { -%>
      <article class="work-entry work-<%= item.slug %>" data-work-category="<%= item.filter %>">
        <div class="entry-eyebrow"><span><%= item.number %> / <%= item.category %></span><span><%= item.kind %></span></div>
        <a class="cover-link" href="<%= url_for(item.path) %>" aria-label="阅读<%= item.name %>项目案例"><%- partial('_partial/linsist-work-cover', { item: item, zoom: false }) %></a>
        <div class="work-copy"><div><h2><a href="<%= url_for(item.path) %>"><%= item.name %></a></h2><p class="work-headline"><%= item.headline %></p><ul class="work-stack" aria-label="技术栈"><% item.stack.forEach(function(tech) { %><li><%= tech %></li><% }); %></ul></div><div><p class="work-description"><%= item.description %></p><a class="case-link" href="<%= url_for(item.path) %>">走进这个项目 <span aria-hidden="true">↗</span></a><p class="work-caption"><%= item.caption %></p></div></div>
      </article>
      <% }); -%>
    </div>
    <section class="work-note"><h2>过程，也值得被看见。</h2><p>这里记录项目要解决的问题、实现中的取舍，以及当前仍待验证的部分。代码和文字会继续一起生长。</p><a class="text-link" href="<%= url_for('/#writing') %>">读开发中的记录 <span aria-hidden="true">↗</span></a></section>
    <% } else { -%>
    <div class="reading-kicker"><a href="<%= url_for('work/') %>">← 全部作品</a><span><%= project.category %></span></div>
    <header class="case-intro"><div><p class="section-label"><%= project.name %></p><h1><% project.headline.split('，').forEach(function(part,index,parts) { %><span class="case-title-part"><%= part + (index < parts.length - 1 ? '，' : '') %></span><% }); %></h1><p class="case-deck"><%= project.description %></p><div class="case-actions"><a class="case-link" href="#screens">先看界面 <span aria-hidden="true">↓</span></a><a class="text-link" href="<%= project.repository %>" target="_blank" rel="noopener noreferrer">项目源码 ↗</a></div></div><dl class="case-facts"><div><dt>项目定位</dt><dd><%= project.kind %></dd></div><div><dt>设计关注</dt><dd><%= project.focus %></dd></div><div><dt>技术组成</dt><dd><%= project.stack.join(' · ') %></dd></div></dl></header>
    <figure class="case-figure"><%- partial('_partial/linsist-work-cover', { item: project, zoom: true }) %><figcaption><span><%= project.caption %></span><span><%= project.cover_note %></span></figcaption></figure>
    <nav class="case-nav" aria-label="项目章节"><a href="#overview">项目概览</a><a href="#screens">界面与体验</a><a href="#flow">使用路径</a><a href="#decisions">设计取舍</a><a href="#evidence">实现范围</a></nav>
    <div class="case-body">
      <section id="overview" class="case-overview"><div><p class="section-label">01 / 出发点</p><h2>从什么问题开始。</h2></div><div><p class="case-lead"><%= project.summary %></p><p><%= project.problem %></p></div></section>
      <% if (project.quote) { %><blockquote class="product-quote"><p><%= project.quote %></p><cite>时光回序 · 核心产品定义</cite></blockquote><% } %>
      <section class="case-principles" aria-label="产品原则"><% project.principles.forEach(function(item,index) { %><div><span class="principle-number">0<%= index + 1 %></span><h3><%= item.title %></h3><p><%= item.text %></p></div><% }); %></section>
      <section id="screens" class="case-gallery gallery-<%= project.slug %>"><header><p class="section-label">02 / 界面与体验</p><h2><%= project.gallery_title %></h2><p class="case-section-note"><%= project.gallery_note %></p><p class="gallery-hint">点击截图可放大查看 ↗</p></header><div class="screen-grid"><% project.screens.forEach(function(screen,index) { %><figure class="screen-feature"><a class="screen-link screen-frame" href="<%= url_for('linsist/assets/work/' + screen.image) %>" data-screen-label="<%= screen.label + ' · ' + screen.title %>" aria-label="放大查看：<%= screen.title %>"><img src="<%= url_for('linsist/assets/work/' + screen.image) %>" alt="<%= screen.alt %>" width="<%= screen.width %>" height="<%= screen.height %>" loading="lazy"><span class="screen-expand" aria-hidden="true">↗</span></a><figcaption><p class="screen-label">0<%= index + 1 %> / <%= screen.label %></p><h3><%= screen.title %></h3><p><%= screen.text %></p></figcaption></figure><% }); %></div></section>
      <section id="flow" class="case-flow"><p class="section-label">03 / 使用路径</p><h2><%= project.slug === 'flashback' ? '让记录，在当下就成立。' : '从资料，到可以核对的回答。' %></h2><p class="case-section-note"><%= project.flow_note || '功能关系示意；本页不连接项目服务。' %></p><ol><% project.flow.forEach(function(step,index) { %><li><span class="flow-number">0<%= index+1 %></span><h3><%= step.title %></h3><p><%= step.text %></p></li><% }); %></ol></section>
      <section id="decisions" class="case-decisions"><p class="section-label">04 / 设计取舍</p><h2>界面背后的判断。</h2><div><% project.decisions.forEach(function(decision, index) { %><details <%= index === 0 ? 'open' : '' %>><summary><%= decision.title %></summary><p><%= decision.text %></p></details><% }); %></div></section>
      <section id="evidence" class="case-evidence"><p class="section-label">05 / 当前进展</p><h2>现在做到了哪里。</h2><div class="evidence-columns"><div><h3>代码中已有的能力</h3><ul><% project.implemented.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div><div><h3>本轮展示与后续验证</h3><ul><% project.limits.forEach(function(item) { %><li><%= item %></li><% }); %></ul></div></div></section>
      <% if (project.articles.length) { -%>
      <section class="case-writing"><h2>沿途的开发记录。</h2><% project.articles.forEach(function(post) { %><a class="related-row" href="<%= url_for(post.path) %>"><h3><%= post.title %></h3><span aria-hidden="true">↗</span></a><% }); %></section>
      <% } -%>
    </div>
    <% const next = projects.find(item => item.slug !== project.slug); -%>
    <a class="next-work" href="<%= url_for(next.path) %>"><div><span>另一段实践</span><h2><%= next.name %></h2></div><span aria-hidden="true">↗</span></a>
    <% } -%>
    <footer class="reading-footer"><a class="wordmark" href="<%= url_for('/') %>">Linsist<span class="brand-dot" aria-hidden="true">.</span></a><p>记录思考，保持好奇。</p><div><a href="<%= url_for('archives/') %>">文章归档 ↗</a><a href="<%= url_for('work/') %>">全部作品 ↗</a></div></footer>
  </main>
  <dialog id="screen-dialog" class="screen-dialog" aria-labelledby="screen-dialog-title"><header><p id="screen-dialog-title"></p><button type="button" class="icon-button" id="screen-close" aria-label="关闭截图">×</button></header><div class="screen-dialog-body"><img id="screen-dialog-image" alt=""></div><p class="screen-dialog-hint">按 Esc 关闭 · 可滚动查看完整截图</p></dialog>
  <dialog id="search-dialog" aria-labelledby="search-title"><div class="search-heading"><h2 id="search-title">搜索文章</h2><button class="icon-button" id="search-close" aria-label="关闭搜索" type="button">×</button></div><label class="sr-only" for="search-input">文章标题或关键词</label><input id="search-input" type="search" placeholder="试试 RAG、调试、Vue…" autocomplete="off"><p class="search-hint" role="status">搜索文章标题、标签与分类 · 按 Esc 关闭</p><div id="search-results"></div><a class="search-archive" href="<%= url_for('archives/') %>">浏览完整文章归档 ↗</a></dialog><div id="reading-status" class="sr-only" role="status" aria-live="polite"></div>
</body>
</html>
