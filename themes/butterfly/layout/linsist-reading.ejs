<% const reading = page.linsistReading; -%>
<!doctype html>
<html lang="zh-CN" data-theme="dark" data-search-index="<%= url_for('linsist/search.json') %>" data-site-root="<%= url_for('/') %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#0b1420">
  <meta name="description" content="<%= reading.summary || page.title %>">
  <meta property="og:type" content="article">
  <meta property="og:title" content="<%= page.title %>">
  <meta property="og:description" content="<%= reading.summary || page.title %>">
  <meta property="og:url" content="<%= page.permalink %>">
  <meta property="article:published_time" content="<%= page.date.toISOString() %>">
  <meta property="article:modified_time" content="<%= page.updated.toISOString() %>">
  <link rel="canonical" href="<%= page.permalink %>">
  <title><%= page.title %> · Lin说 / Linsist</title>
  <link rel="icon" href="<%= url_for('linsist/assets/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= url_for('linsist/style.css') %>">
  <link rel="stylesheet" href="<%= url_for('linsist/reading.css') %>">
  <link rel="stylesheet" href="<%= url_for('linsist/motion.css') %>">
  <link rel="stylesheet" href="<%= url_for('linsist/overlays.css') %>?v=ambient-20261029">
  <script>try{const t=localStorage.getItem('lin-theme');document.documentElement.dataset.theme=t==='light'?'light':'dark';const s=Number(localStorage.getItem('lin-reading-size'));if(s>=16&&s<=22)document.documentElement.style.setProperty('--reading-size',s+'px')}catch{}</script>
  <script src="<%= url_for('linsist/motion.js') %>"></script>
  <script src="<%= url_for('linsist/overlays.js') %>?v=ambient-20261029" defer></script>
  <script src="<%= url_for('linsist/reading.js') %>?v=ambient-20261029" defer></script>
</head>
<body class="reading-page<%= reading.editorial ? ' has-editorial' : '' %>">
  <a class="skip-link" href="#article-container">跳转到正文</a>
  <header class="site-header is-scrolled reading-header">
    <a class="wordmark" href="<%= url_for('/') %>" aria-label="Linsist，返回首页">Linsist<span class="brand-dot" aria-hidden="true">.</span></a>
    <nav class="desktop-nav" aria-label="主导航">
      <a href="<%= url_for('/') %>">首页</a><a href="<%= url_for('work/') %>">作品</a><a href="<%= url_for('/#writing') %>" aria-current="page">文章</a><a href="<%= url_for('/#about') %>">关于</a>
    </nav>
    <div class="header-actions">
      <button class="icon-button search-trigger" type="button" aria-label="搜索文章"><span class="search-icon" aria-hidden="true"></span><kbd>/</kbd></button>
      <button class="icon-button theme-toggle" type="button" aria-label="切换为浅色主题"><span aria-hidden="true">◐</span></button>
      <a class="github-link" href="https://github.com/Lin-sist" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <button class="icon-button menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="打开导航菜单"><span class="menu-icon" aria-hidden="true"></span></button>
    </div>
    <nav id="mobile-nav" aria-label="手机导航" hidden><a href="<%= url_for('/') %>">首页</a><a href="<%= url_for('work/') %>">作品</a><a href="<%= url_for('/#writing') %>">文章</a><a href="<%= url_for('/#about') %>">关于</a></nav>
    <div class="reading-track" aria-hidden="true"><span id="reading-progress"></span></div>
  </header>

  <main class="reading-shell" id="main">
    <div class="reading-kicker"><a href="<%= url_for('/#writing') %>">← 返回文章</a><span>Lin说 <span aria-hidden="true">/</span> <%= reading.category %></span></div>
    <div class="reading-layout">
      <div class="reading-column">
        <header class="article-heading<%= reading.editorial ? ' is-edited' : '' %>" id="article-top">
          <p class="section-label">文字与思考 <span aria-hidden="true">·</span> <%= reading.editorial ? reading.editorial.kind : reading.category %></p>
          <h1><%= page.title %></h1>
          <% if (reading.summary) { %><p class="article-deck"><%= reading.summary %></p><% } -%>
          <div class="article-meta"><span>Linsist</span><span aria-hidden="true">/</span><time datetime="<%= page.date.toISOString() %>"><%= page.date.format('YYYY.MM.DD') %></time><span aria-hidden="true">/</span><span>约 <%= reading.minutes %> 分钟</span></div>
          <% if (page.updated.diff(page.date, 'days') > 0) { %><p class="article-updated">更新于 <time datetime="<%= page.updated.toISOString() %>"><%= page.updated.format('YYYY.MM.DD') %></time></p><% } -%>
          <% if (page.tags.length) { %><ul class="reading-tags" aria-label="文章标签"><% page.tags.forEach(function(tag) { %><li><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a></li><% }); %></ul><% } -%>
        </header>
        <% if (reading.editorial) { -%>
        <aside class="editorial-guide" aria-label="读前导览"><p class="editorial-label">读前导览</p><p><%= reading.editorial.intro %></p><% if (reading.editorial.jumps.length) { %><nav aria-label="建议阅读入口"><% reading.editorial.jumps.forEach(function(jump) { %><a href="#<%= encodeURIComponent(jump.id) %>"><%= jump.label %><span aria-hidden="true"> ↓</span></a><% }); %></nav><% } %></aside>
        <% } -%>
        <article id="article-container" class="post-content reading-content" tabindex="-1" aria-label="<%= page.title %>正文"><%- reading.content %></article>
        <div class="article-end"><span class="end-point" aria-hidden="true"></span><span>这一段思考，先记到这里。</span><button type="button" id="copy-article-link" hidden>复制文章链接 ↗</button></div>
        <% if (reading.project) { %><aside class="reading-project" aria-label="相关项目"><p class="section-label">从文字到实践</p><a href="<%= url_for(reading.project.url) %>"><strong><%= reading.project.name %></strong><span aria-hidden="true">↗</span></a><p><%= reading.project.description %></p></aside><% } -%>
        <% if (reading.related.length) { %><section class="related-reading" aria-labelledby="related-title"><p class="section-label">继续沿途的思考</p><h2 id="related-title">也许你还想读。</h2><div><% reading.related.forEach(function(post) { %><a class="related-row" href="<%= url_for(post.path) %>"><div><h3><%= post.title %></h3><% if (post.summary) { %><p><%= post.summary %></p><% } %><time><%= post.date %></time></div><span aria-hidden="true">↗</span></a><% }); %></div></section><% } -%>
      </div>
      <aside class="reading-sidebar" aria-label="阅读工具">
        <details class="reading-toc" open>
          <summary>本篇目录 <span class="toc-position" id="reading-percent">阅读轨迹</span></summary>
          <div class="toc-body"><nav aria-label="文章目录"><% if (reading.headings.length) { %><ol><% reading.headings.forEach(function(item) { %><li class="toc-level-<%= item.level %>"><a href="#<%= encodeURIComponent(item.id) %>"><%= item.title %></a></li><% }); %></ol><% } else { %><p class="toc-empty">从这里，慢慢读完。</p><% } %></nav><a class="back-to-article" href="#article-top">回到文章开头 ↑</a></div>
        </details>
        <div class="reading-tools" hidden><span>字号</span><div><button id="font-smaller" type="button" aria-label="缩小正文字号">A−</button><output id="font-size" aria-label="当前正文字号">18</output><button id="font-larger" type="button" aria-label="放大正文字号">A+</button></div></div>
        <p class="sidebar-note">让思考，留下轨迹。</p>
      </aside>
    </div>
    <footer class="reading-footer"><a class="wordmark" href="<%= url_for('/') %>">Linsist<span class="brand-dot" aria-hidden="true">.</span></a><p>记录思考，保持好奇。</p><div><a href="<%= url_for('archives/') %>">文章归档 ↗</a><a href="<%= url_for('work/') %>">查看作品 ↗</a></div></footer>
  </main>
  <dialog id="search-dialog" aria-labelledby="search-title"><div class="search-heading"><h2 id="search-title">搜索文章</h2><button class="icon-button" id="search-close" aria-label="关闭搜索" type="button">×</button></div><label class="sr-only" for="search-input">文章标题或关键词</label><input id="search-input" type="search" placeholder="试试 RAG、调试、Vue…" autocomplete="off"><p class="search-hint" role="status">搜索文章标题、标签与分类 · 按 Esc 关闭</p><div id="search-results"></div><a class="search-archive" href="<%= url_for('archives/') %>">浏览完整文章归档 ↗</a></dialog>
  <div id="reading-status" class="sr-only" role="status" aria-live="polite"></div>
</body>
</html>
